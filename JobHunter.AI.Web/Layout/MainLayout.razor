@inherits LayoutComponentBase

<div class="app-shell">
    <aside class="sidebar">
        <div class="logo">
            <div class="logo-dot"></div>
            JobHunter.AI
        </div>

        <div class="nav-section">
            <div class="nav-label">Tools</div>
            <NavLink class="nav-item" href="" Match="NavLinkMatch.All">
                <span class="nav-icon">✦</span> Smart analyze
            </NavLink>
            <NavLink class="nav-item" href="/applications">
                <span class="nav-icon">⊞</span> Applications
            </NavLink>
            <NavLink class="nav-item" href="/resumes">
                <span class="nav-icon">📄</span> Resumes
            </NavLink>
            <NavLink class="nav-item" href="/interview-bank">
                <span class="nav-icon">📝</span> Interview Bank
            </NavLink>
            <NavLink class="nav-item" href="/career-chat">
                <span class="nav-icon">💬</span> Career Chat
            </NavLink>
            <NavLink class="nav-item" href="/resume-tailor">
                <span class="nav-icon">✂</span> Resume Tailor
            </NavLink>
        </div>
        <div class="nav-section session-section">
            
            <button type="button" class="nav-item session-signout" @onclick="SignOut" title="Sign out">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M10 17l5-5-5-5m5 5H3m9-9h7a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-7" />
                </svg>
                Sign out
            </button>
        </div>
    </aside>

    <main class="main-content">
        @Body
    </main>
</div>

@code {
    [CascadingParameter] public Func<Task>? OnSignOut { get; set; }
    private Task SignOut() => OnSignOut?.Invoke() ?? Task.CompletedTask;
}
