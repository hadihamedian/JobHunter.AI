@page "/"
@inject HttpClient Http
@inject ResumeService ResumeService
@using JobHunter.AI.Web.Models
@using JobHunter.AI.Web.Services
@using Microsoft.AspNetCore.Components.Web

<!-- Job Description Panel -->
<div class="analyze-grid">
    <div class="panel">
        <div class="panel-title">📋 Job description</div>
        <textarea class="analyze-textarea"
                  placeholder="Paste the job posting here..."
                  @bind="jobDescription"
                  rows="8"></textarea>
    </div>

    <div class="panel">
        <div class="panel-title">📄 Your resume</div>

        @if (isLoadingResumes)
        {
            <div style="color:#555560;font-size:12px;padding:8px 0">Loading resumes...</div>
        }
        else if (resumes.Count == 0)
        {
            <div class="no-resumes">
                <div style="font-size:13px;color:#555560;margin-bottom:10px">
                    No resumes yet.
                </div>
                <a href="/resumes" class="btn-primary" style="text-decoration:none;display:inline-flex">
                    + Add your first resume
                </a>
            </div>
        }
        else
        {
            <div class="resume-select-list">
                @foreach (var resume in resumes)
                {
                    <div class="resume-option @(selectedResumeId == resume.Id ? "resume-option-selected" : "")"
                        @onclick="() => selectedResumeId = resume.Id">
                        <div style="display:flex;align-items:center;gap:8px">
                            <div class="resume-option-dot @(selectedResumeId == resume.Id ? "resume-option-dot-active" : "")"></div>
                            <div>
                                <div class="resume-option-name">
                                    @resume.Name
                                    @if (resume.IsDefault)
                                    {
                                        @* <span class="default-badge" style="margin-left:6px">Default</span> *@
                                    }
                                </div>
                                <div class="resume-option-meta">@resume.WordCount words · @resume.CreatedAt.ToString("MMM d")</div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <a href="/resumes" style="font-size:11px;color:#6366f1;text-decoration:none;display:block;margin-top:10px">
                Manage resumes →
            </a>
        }

        <button class="btn-analyze"
                @onclick="Analyze"
                disabled="@(isAnalyzing || selectedResumeId == Guid.Empty || string.IsNullOrWhiteSpace(jobDescription))">
            @(isAnalyzing ? "Analyzing..." : "✦ Analyze now")
        </button>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="error">@errorMessage</div>
        }
    </div>
</div>

<!-- Result -->
@if (result != null)
{
    <div class="result-panel">
        <div class="result-header">
            <div style="font-size:13px;font-weight:500;color:#e8e8ea">Analysis result</div>

            <div class="ats-ring-wrap">
                <svg width="110" height="110" viewBox="0 0 110 110" class="ats-ring-svg">
                    <circle cx="55" cy="55" r="46" fill="none" stroke="#22222a" stroke-width="8" />
                    <circle cx="55" cy="55" r="46" fill="none"
                            stroke="url(#atsGradient)"
                            stroke-width="8"
                            stroke-linecap="round"
                            stroke-dasharray="@ScoreCircumference"
                            stroke-dashoffset="@ScoreOffset"
                            transform="rotate(-90 55 55)"
                            style="transition: stroke-dashoffset 1s ease-out;" />
                    <defs>
                        <linearGradient id="atsGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="@GradientStart" />
                            <stop offset="100%" stop-color="@GradientEnd" />
                        </linearGradient>
                    </defs>
                </svg>
                <div class="ats-ring-center">
                    <div class="ats-ring-number">@result.AtsScore</div>
                    <div class="ats-ring-label">/100</div>
                </div>
            </div>
        </div>

        <div class="result-grid">
            <div class="result-card">
                <div class="result-card-title">You have these ✓</div>
                @foreach (var skill in result.MatchingSkills)
                {
                    <span class="chip chip-have">@skill</span>
                }
            </div>
            <div class="result-card">
                <div class="result-card-title">Critical gaps</div>
                @foreach (var skill in result.CriticalMissingSkills)
                {
                    <span class="chip chip-critical">@skill</span>
                }
            </div>
            <div class="result-card">
                <div class="result-card-title">Add to resume</div>
                @foreach (var skill in result.MissingSkills.Take(5))
                {
                    <span class="chip chip-improve">@skill</span>
                }
            </div>
        </div>

        @if (result.Suggestions.Any())
        {
            <div class="suggestions">
                <div class="suggestion-title">💡 Suggestions</div>
                @foreach (var s in result.Suggestions)
                {
                    <div class="suggestion-item">
                        <span class="suggestion-dot">·</span>
                        <span>@s</span>
                    </div>
                }
            </div>
        }

        <!-- Career Chat -->
        <div class="chat-section" style="margin-top:16px">
            <div class="chat-header">
                <span style="color:#6366f1">💬</span>
                <div style="font-size:12px;font-weight:500;color:#e8e8ea">Ask about this job</div>
                <span class="chat-badge">AI powered</span>
            </div>

            @if (chatMessages.Count == 0)
            {
                <div class="chat-suggestions">
                    <button class="chat-suggestion-chip" @onclick='() => QuickAsk("What should I learn first to close my skill gaps?")'>
                        What should I learn first?
                    </button>
                    <button class="chat-suggestion-chip" @onclick='() => QuickAsk("Why is my ATS score not higher?")'>
                        Why is my score not higher?
                    </button>
                    <button class="chat-suggestion-chip" @onclick='() => QuickAsk("Am I ready to apply for this job?")'>
                        Am I ready to apply?
                    </button>
                </div>
            }

            <div class="chat-messages">
                @foreach (var msg in chatMessages)
                {
                    @if (msg.Role == "user")
                    {
                        <div class="chat-msg-user">@msg.Content</div>
                    }
                    else
                    {
                        <div class="chat-msg-ai">
                            <div class="chat-msg-ai-text">@msg.Content</div>
                        </div>
                    }
                }
                @if (isChatLoading)
                {
                    <div class="chat-msg-ai">
                        <div class="chat-msg-ai-text chat-loading-dots">...</div>
                    </div>
                }
            </div>

            <div class="chat-input-row">
                <input class="chat-input"
                       placeholder="Ask about this job..."
                       @bind="chatInput"
                       @bind:event="oninput"
                       @onkeydown="HandleKeyDown" />
                <button class="chat-send-btn"
                        @onclick="SendChatMessage"
                        disabled="@(isChatLoading || string.IsNullOrWhiteSpace(chatInput))">
                    Send
                </button>
            </div>
        </div>
    </div>
}

@code {
    // Resume selection
    List<ResumeSummary> resumes = new();
    Guid selectedResumeId = Guid.Empty;
    bool isLoadingResumes = true;

    // Analysis
    string jobDescription = "";
    AnalyzeResult? result = null;
    bool isAnalyzing = false;
    string? errorMessage = null;
    double ScoreCircumference => 2 * Math.PI * 46;
    double ScoreOffset => ScoreCircumference - (result!.AtsScore / 100.0 * ScoreCircumference);

    string GradientStart => result!.AtsScore >= 75 ? "#818cf8" : result.AtsScore >= 50 ? "#facc15" : "#f87171";
    string GradientEnd => result!.AtsScore >= 75 ? "#c084fc" : result.AtsScore >= 50 ? "#fb923c" : "#ef4444";


    // Chat
    List<(string Role, string Content)> chatMessages = new();
    string chatInput = "";
    bool isChatLoading = false;

    protected override async Task OnInitializedAsync()
    {
        resumes = await ResumeService.GetAllAsync();

        // default resume رو انتخاب کن
        var defaultResume = resumes.FirstOrDefault(r => r.IsDefault);
        if (defaultResume != null)
            selectedResumeId = defaultResume.Id;
        else if (resumes.Count > 0)
            selectedResumeId = resumes[0].Id;

        isLoadingResumes = false;
    }

    async Task Analyze()
    {
        if (selectedResumeId == Guid.Empty || string.IsNullOrWhiteSpace(jobDescription))
            return;

        isAnalyzing = true;
        errorMessage = null;
        result = null;
        chatMessages.Clear();

        try
        {
            var response = await Http.PostAsJsonAsync("/api/analyze-by-id", new
            {
                ResumeId = selectedResumeId,
                JobDescription = jobDescription
            });

            if (response.IsSuccessStatusCode)
                result = await response.Content.ReadFromJsonAsync<AnalyzeResult>();
            else
                errorMessage = "Analysis failed. Please try again.";
        }
        catch
        {
            errorMessage = "Could not connect to the server.";
        }

        isAnalyzing = false;
    }

    string BuildAnalysisSummary()
    {
        if (result == null) return "";
        return $"ATS Score: {result.AtsScore}/100. " +
               $"Matching: {string.Join(", ", result.MatchingSkills)}. " +
               $"Missing: {string.Join(", ", result.MissingSkills)}. " +
               $"Critical gaps: {string.Join(", ", result.CriticalMissingSkills)}.";
    }

    async Task SendChatMessage()
    {
        if (string.IsNullOrWhiteSpace(chatInput) || isChatLoading) return;

        var question = chatInput.Trim();
        chatInput = "";
        chatMessages.Add(("user", question));
        isChatLoading = true;
        StateHasChanged();

        try
        {
            var selectedResume = resumes.FirstOrDefault(r => r.Id == selectedResumeId);
            var resumeDetail = selectedResume != null
                ? await ResumeService.GetByIdAsync(selectedResumeId)
                : null;

            var payload = new
            {
                ResumeContent = resumeDetail?.Content ?? "",
                JobDescription = jobDescription,
                AnalysisSummary = BuildAnalysisSummary(),
                History = chatMessages.SkipLast(1)
                    .Select(m => new { Role = m.Role, Content = m.Content })
                    .ToList(),
                UserMessage = question
            };

            var response = await Http.PostAsJsonAsync("/api/chat", payload);
            if (response.IsSuccessStatusCode)
            {
                var chatResponse = await response.Content
                    .ReadFromJsonAsync<ChatResponse>();
                chatMessages.Add(("assistant", chatResponse?.Reply ?? ""));
            }
        }
        catch { }

        isChatLoading = false;
    }

    async Task QuickAsk(string question)
    {
        chatInput = question;
        await SendChatMessage();
    }

    async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
            await SendChatMessage();
    }

    // local records برای deserialize
    record AnalyzeResult(
        int AtsScore,
        List<string> MatchingSkills,
        List<string> MissingSkills,
        List<string> CriticalMissingSkills,
        List<string> Suggestions);

    record ChatResponse(string Reply);
}