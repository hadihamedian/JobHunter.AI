@page "/"
@inject HttpClient Http
@using Microsoft.AspNetCore.Components.Web

<div class="grid-2">
    <div class="panel">
        <div class="panel-title">Job Description</div>
        <textarea @bind="jobDescription" placeholder="Paste job description here..."></textarea>
    </div>
    <div class="panel">
        <div class="panel-title">Your Resume</div>
        <textarea @bind="resumeContent" placeholder="Paste your resume content here..."></textarea>
    </div>
</div>

<button class="btn-analyze" @onclick="AnalyzeAsync" disabled="@isLoading">
    @(isLoading ? "Analyzing..." : "Analyze now")
</button>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="error">@errorMessage</div>
}

@if (isLoading)
{
    <div class="loading">Analyzing resume against job description via Ollama...</div>
}
else if (result != null)
{
    <div class="result-panel">
        <div>
            <div class="score">@result.AtsScore%</div>
            <div class="score-label">ATS MATCH SCORE</div>
        </div>

        <div class="result-grid">
            <div class="result-card">
                <div class="result-card-title">MATCHING SKILLS</div>
                @foreach (var skill in result.MatchingSkills ?? new())
                {
                    <span class="chip chip-have">@skill</span>
                }
            </div>
            <div class="result-card">
                <div class="result-card-title">MISSING SKILLS</div>
                @foreach (var skill in result.MissingSkills ?? new())
                {
                    <span class="chip chip-missing">@skill</span>
                }
            </div>
            <div class="result-card">
                <div class="result-card-title">CRITICAL MISSING</div>
                @foreach (var skill in result.CriticalMissingSkills ?? new())
                {
                    <span class="chip chip-critical">@skill</span>
                }
            </div>
        </div>

        <div class="suggestions">
            <div class="suggestion-title">SUGGESTIONS FOR IMPROVEMENT</div>
            @foreach (var suggestion in result.Suggestions ?? new())
            {
                <div class="suggestion-item">
                    <span class="suggestion-dot">•</span>
                    <span>@suggestion</span>
                </div>
            }
        </div>
    </div>

    <div class="chat-panel">
        <div class="panel-title">💬 Ask about this job</div>
        
        <div class="chat-messages" id="chat-messages">
            @if (chatHistory.Count == 0)
            {
                <div class="chat-empty">
                    Ask me anything about this job and your resume...
                </div>
                <div class="chat-suggestions">
                    <button class="chat-suggestion-btn" @onclick='() => QuickAsk("What should I learn first to close my skill gaps?")'>
                        What should I learn first?
                    </button>
                    <button class="chat-suggestion-btn" @onclick='() => QuickAsk("Why is my ATS score not higher?")'>
                        Why is my score not higher?
                    </button>
                    <button class="chat-suggestion-btn" @onclick='() => QuickAsk("Am I ready to apply for this job?")'>
                        Am I ready to apply?
                    </button>
                </div>
            }
            
            @foreach (var msg in chatHistory)
            {
                <div class="chat-msg @(msg.Role == "user" ? "chat-msg-user" : "chat-msg-assistant")" dir="auto">
                    @msg.Content
                </div>
            }
            
            @if (isChatLoading)
            {
                <div class="chat-msg chat-msg-assistant chat-loading">
                    <span class="dot">.</span><span class="dot">.</span><span class="dot">.</span>
                </div>
            }
        </div>
        
        <div class="chat-input-row">
            <input 
                class="chat-input" 
                placeholder="Ask about this job..." 
                @bind="currentMessage"
                @bind:event="oninput"
                @onkeydown="HandleKeyDown"
                dir="auto"/>
            <button class="chat-send-btn" @onclick="SendMessage" disabled="@(isChatLoading || string.IsNullOrWhiteSpace(currentMessage))">
                Send
            </button>
        </div>
    </div>
}

@code {
    private string jobDescription = "";
    private string resumeContent = "";
    private AnalyzeResult? result = null;
    private bool isLoading = false;
    private string? errorMessage = null;

    // Chat State
    List<ChatMessage> chatHistory = new();
    string currentMessage = "";
    bool isChatLoading = false;

    private async Task AnalyzeAsync()
    {
        if (string.IsNullOrWhiteSpace(jobDescription) || string.IsNullOrWhiteSpace(resumeContent))
        {
            errorMessage = "Please provide both Job Description and Resume.";
            return;
        }

        isLoading = true;
        errorMessage = null;
        result = null;
        chatHistory.Clear(); // ریست کردن چت با آنالیز جدید

        try
        {
            var request = new { ResumeContent = resumeContent, JobDescription = jobDescription };
            var response = await Http.PostAsJsonAsync("/api/analyze", request);
            
            if (response.IsSuccessStatusCode)
            {
                result = await response.Content.ReadFromJsonAsync<AnalyzeResult>();
            }
            else
            {
                errorMessage = "Failed to analyze. Ensure API and Ollama are running.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(currentMessage) || isChatLoading) return;

        var userMsg = currentMessage.Trim();
        currentMessage = "";
        
        chatHistory.Add(new ChatMessage("user", userMsg));
        isChatLoading = true;
        StateHasChanged();

        var request = new
        {
            ResumeContent = resumeContent,
            JobDescription = jobDescription,
            AnalysisSummary = BuildAnalysisSummary(),
            History = chatHistory.SkipLast(1).ToList(),
            UserMessage = userMsg
        };

        var response = await Http.PostAsJsonAsync("/api/chat", request);
        if (response.IsSuccessStatusCode)
        {
            var chatRes = await response.Content.ReadFromJsonAsync<ChatResponse>();
            chatHistory.Add(new ChatMessage("assistant", chatRes?.Reply ?? ""));
        }
        else
        {
            chatHistory.Add(new ChatMessage("assistant", "Sorry, an error occurred communicating with the AI."));
        }
        
        isChatLoading = false;
    }

    string BuildAnalysisSummary()
    {
        if (result == null) return "";
        return $"ATS Score: {result.AtsScore}/100. " +
               $"Matching skills: {string.Join(", ", result.MatchingSkills ?? new())}. " +
               $"Missing skills: {string.Join(", ", result.MissingSkills ?? new())}. " +
               $"Critical gaps: {string.Join(", ", result.CriticalMissingSkills ?? new())}.";
    }

    async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
            await SendMessage();
    }

    async Task QuickAsk(string question)
    {
        currentMessage = question;
        await SendMessage();
    }

    public record AnalyzeResult(
        int AtsScore,
        List<string> MatchingSkills,
        List<string> MissingSkills,
        List<string> CriticalMissingSkills,
        List<string> Suggestions
    );

    public record ChatMessage(string Role, string Content);
    public record ChatResponse(string Reply);
}
