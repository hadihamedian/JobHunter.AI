@page "/resumes"
@using JobAssistant.Web.Models
@using JobAssistant.Web.Services
@inject ResumeService ResumeService

<div class="page-header">
    <h1 class="page-title">My resumes</h1>
    <button class="btn-primary" @onclick="OpenAddModal">+ Add resume</button>
</div>

@if (isLoading)
{
    <div class="loading">Loading resumes...</div>
}
else
{
    <div class="resume-grid">
        @foreach (var resume in resumes)
        {
            <div class="resume-card @(resume.IsDefault ? "resume-card-default" : "")">
                @if (resume.IsDefault)
                {
                    <span class="default-badge">Default</span>
                }
                <div class="resume-icon">📄</div>
                <div class="resume-name">@resume.Name</div>
                <div class="resume-meta">
                    Updated @(resume.UpdatedAt?.ToString("MMM d") ?? resume.CreatedAt.ToString("MMM d"))
                    · @resume.WordCount words
                </div>
                <div class="resume-actions">
                    <button class="ca-btn ca-primary" @onclick="() => OpenEditModal(resume.Id)">
                        Edit
                    </button>
                    @if (!resume.IsDefault)
                    {
                        <button class="ca-btn" @onclick="() => SetDefault(resume.Id)">
                            Set default
                        </button>
                    }
                    <button class="ca-btn ca-danger" @onclick="() => DeleteResume(resume.Id)">
                        Delete
                    </button>
                </div>
            </div>
        }
    </div>

    <div class="recommend-panel">
        <div class="recommend-title">
            ✦ Which resume should I send?
            <span class="recommend-subtitle">paste job description → get AI recommendation</span>
        </div>

        <div class="recommend-input-row">
            <textarea class="recommend-textarea"
                      placeholder="Paste the job description here..."
                      @bind="jobDescriptionForRecommend"
                      rows="3"></textarea>
            <button class="btn-primary"
                    @onclick="GetRecommendation"
                    disabled="@(isRecommending || string.IsNullOrWhiteSpace(jobDescriptionForRecommend))">
                @(isRecommending ? "Analyzing..." : "Recommend")
            </button>
        </div>

        @if (recommendation != null)
        {
            <div class="recommendation-result">
                <div class="rec-header">
                    <div>
                        <div class="rec-label">Best match</div>
                        <div class="rec-winner">@recommendation.BestResumeName</div>
                    </div>
                    <div class="rec-score">@recommendation.BestScore%</div>
                </div>
                <div class="rec-reasoning">@recommendation.Reasoning</div>
                <div class="rec-scores">
                    @foreach (var score in recommendation.AllScores)
                    {
                        <div class="rec-score-item @(score.ResumeId == recommendation.BestResumeId ? "rec-score-best" : "")">
                            <div class="rec-score-name @(score.ResumeId == recommendation.BestResumeId ? "rec-score-name-best" : "")">
                                @score.ResumeName
                            </div>
                            <div class="rec-score-bar-wrap">
                                <div class="rec-score-bar"
                                     style="width:@(score.Score)%;background:@(score.ResumeId == recommendation.BestResumeId ? "#4ade80" : "#2a2a3e")">
                                </div>
                            </div>
                            <div class="rec-score-val @(score.ResumeId == recommendation.BestResumeId ? "rec-score-val-best" : "")">
                                @score.Score%
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@if (showModal)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-title">@(editingId.HasValue ? "Edit resume" : "Add resume")</div>

            <div class="form-group">
                <label class="form-label">Name</label>
                <input type="text" class="form-input"
                       placeholder="e.g. Senior Backend v4"
                       @bind="modalName" />
            </div>

            <div class="form-group">
                <label class="form-label">Resume content</label>
                <textarea class="form-textarea resume-content-textarea"
                          placeholder="Paste your full resume text here..."
                          @bind="modalContent"></textarea>
            </div>

            <div class="form-group" style="display:flex;align-items:center;gap:8px">
                <input type="checkbox" id="isDefault" @bind="modalIsDefault"
                       style="accent-color:#6366f1" />
                <label for="isDefault" class="form-label" style="margin:0">
                    Set as default resume
                </label>
            </div>

            <div class="modal-actions">
                <button class="btn-cancel" @onclick="CloseModal">Cancel</button>
                <button class="btn-primary" @onclick="SaveModal" disabled="@isSaving">
                    @(isSaving ? "Saving..." : "Save")
                </button>
            </div>
        </div>
    </div>
}

@code {
    List<ResumeSummary> resumes = new();
    bool isLoading = true;

    // Recommend
    string jobDescriptionForRecommend = "";
    bool isRecommending = false;
    ResumeRecommendation? recommendation = null;

    // Modal
    bool showModal = false;
    Guid? editingId = null;
    string modalName = "";
    string modalContent = "";
    bool modalIsDefault = false;
    bool isSaving = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadResumes();
    }

    async Task LoadResumes()
    {
        isLoading = true;
        resumes = await ResumeService.GetAllAsync();
        isLoading = false;
    }

    void OpenAddModal()
    {
        editingId = null;
        modalName = "";
        modalContent = "";
        modalIsDefault = resumes.Count == 0;
        showModal = true;
    }

    async Task OpenEditModal(Guid id)
    {
        var detail = await ResumeService.GetByIdAsync(id);
        if (detail is null) return;
        editingId = id;
        modalName = detail.Name;
        modalContent = detail.Content;
        modalIsDefault = detail.IsDefault;
        showModal = true;
    }

    void CloseModal()
    {
        showModal = false;
    }

    async Task SaveModal()
    {
        if (string.IsNullOrWhiteSpace(modalName) ||
            string.IsNullOrWhiteSpace(modalContent)) return;

        isSaving = true;

        if (editingId.HasValue)
        {
            await ResumeService.UpdateAsync(editingId.Value, new UpdateResumeRequest(
                modalName, modalContent, modalIsDefault));
        }
        else
        {
            await ResumeService.CreateAsync(new CreateResumeRequest(
                modalName, modalContent, modalIsDefault));
        }

        isSaving = false;
        showModal = false;
        await LoadResumes();
    }

    async Task SetDefault(Guid id)
    {
        await ResumeService.UpdateAsync(id, new UpdateResumeRequest(null, null, true));
        await LoadResumes();
    }

    async Task DeleteResume(Guid id)
    {
        await ResumeService.DeleteAsync(id);
        await LoadResumes();
    }

    async Task GetRecommendation()
    {
        if (string.IsNullOrWhiteSpace(jobDescriptionForRecommend)) return;
        isRecommending = true;
        recommendation = null;
        recommendation = await ResumeService.RecommendAsync(jobDescriptionForRecommend);
        isRecommending = false;
    }
}